{
  "name": "sheep-civilization",
  "description": "A 2D pixel-art clicker about keeping a flock of sheep alive. Phaser 4, TypeScript, Vite.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "assets": "node scripts/build-assets.ts",
    "zip": "node -e \"console.log('[zip] implemented in Story 5.2')\""
  },
  "dependencies": {
    "phaser": "~4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "free-tex-packer-core": "^0.3.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "~4.1.11"
  }
}
